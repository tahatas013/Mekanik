{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mekanik:schema:v1:standard-item",
  "title": "Standart haritası maddesi (standard item)",
  "description": "Standart haritası G0'da çıkar. Her madde: amaç, neden burada, test yöntemi, kabul ölçütü, kanıt, doğrulama durumu ve tür. Tik yalnız kanıtla ve kalite mühendisinin kontrolünden sonra konur. Aynı şema standart kütüphanesindeki (katman 3) madde şablonları için de kullanılır (work yerine library: true). Dosya: stdmap.yaml (liste) ya da stdlib/items/*.yaml.",
  "x-schema-version": "1.0.0",
  "type": "object",
  "required": [
    "kind",
    "schema_version",
    "id",
    "title",
    "type",
    "access",
    "citation",
    "purpose",
    "verification_status"
  ],
  "properties": {
    "kind": {
      "const": "standard_item"
    },
    "schema_version": {
      "$ref": "urn:mekanik:schema:v1:common#/$defs/schema_version"
    },
    "id": {
      "type": "string",
      "pattern": "^(SM-[0-9]{2,3}|[a-z0-9]+(\\.[a-z0-9-]+)+)$",
      "description": "Çalışmada SM-nn; kütüphanede noktalı kimlik (ör. eu.2023-988.art5)."
    },
    "work": {
      "$ref": "urn:mekanik:schema:v1:common#/$defs/work_code"
    },
    "library": {
      "type": "boolean",
      "default": false
    },
    "from_library": {
      "type": "string",
      "description": "Çalışma maddesinin türetildiği kütüphane maddesi."
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "enum": [
        "regulation",
        "customer_spec",
        "standard",
        "guideline",
        "literature"
      ],
      "description": "mevzuat | müşteri şartnamesi | standart | kılavuz | literatür"
    },
    "access": {
      "enum": [
        "open",
        "paid",
        "customer_provided"
      ],
      "description": "Açık metin mi, paralı mı."
    },
    "priority": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5,
      "description": "Kaynak önceliği (türetilir): 1 mevzuat, 2 müşteri şartnamesi, 3 açık teknik kaynak (JCGM, NASA, MIL, NIST), 4 üretici kılavuzu, 5 paralı standart."
    },
    "citation": {
      "type": "object",
      "required": [
        "document"
      ],
      "properties": {
        "document": {
          "type": "string",
          "description": "Belge numarası ve adı, ör. '(EU) 2023/988' ya da 'JCGM 100:2008'."
        },
        "clause": {
          "type": "string"
        },
        "edition": {
          "type": "string"
        },
        "celex": {
          "type": "string",
          "pattern": "^[0-9A-Z]{6,}$"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "read_on": {
          "type": "string",
          "format": "date",
          "description": "Atfın okunduğu gün (isteğe bağlı, şema 1.1). Mevzuat değişkendir: okuma 365 günden eskiyse STDMAP-01 yeniden doğrulama uyarısı verir."
        }
      },
      "additionalProperties": false
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "why_here": {
      "type": "string"
    },
    "test_method": {
      "type": "string"
    },
    "acceptance": {
      "type": "object",
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": "string"
        },
        "criterion": {
          "$ref": "urn:mekanik:schema:v1:common#/$defs/quantity"
        },
        "requirement": {
          "type": "string",
          "pattern": "^R-[0-9]{2,3}$"
        }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "urn:mekanik:schema:v1:common#/$defs/ref"
      }
    },
    "verification_status": {
      "$ref": "urn:mekanik:schema:v1:common#/$defs/verification_status"
    },
    "mandatory": {
      "type": "boolean",
      "description": "Zorunlu madde (isteğe bağlı, şema 1.1): G5'te tiksiz zorunlu madde kalmaz (STDMAP-01). Yoksa mevzuat ve müşteri şartnamesi zorunlu, diğerleri değil sayılır."
    },
    "status": {
      "$ref": "urn:mekanik:schema:v1:common#/$defs/requirement_status"
    },
    "tick": {
      "type": "object",
      "required": [
        "checked"
      ],
      "properties": {
        "checked": {
          "type": "boolean"
        },
        "quality_review": {
          "allOf": [
            {
              "$ref": "urn:mekanik:schema:v1:common#/$defs/ref"
            },
            {
              "properties": {
                "kind": {
                  "const": "quality_review"
                }
              }
            }
          ]
        },
        "at": {
          "$ref": "urn:mekanik:schema:v1:common#/$defs/timestamp"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "checked": {
                "const": true
              }
            }
          },
          "then": {
            "required": [
              "quality_review",
              "at"
            ]
          }
        }
      ]
    },
    "open_equivalent": {
      "description": "Paralı standart için açık karşılık araması.",
      "type": "object",
      "required": [
        "searched"
      ],
      "properties": {
        "searched": {
          "type": "boolean"
        },
        "found": {
          "type": "string",
          "description": "Bulunan açık karşılığın madde kimliği."
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "procurement": {
      "type": "object",
      "required": [
        "needed",
        "justification"
      ],
      "properties": {
        "needed": {
          "type": "boolean"
        },
        "justification": {
          "type": "string",
          "minLength": 1
        },
        "approved": {
          "$ref": "urn:mekanik:schema:v1:common#/$defs/ref"
        }
      },
      "additionalProperties": false
    },
    "applies_to": {
      "description": "Kütüphane maddesi için: hangi iş türü/paket/ürün özelliğinde önerilir (ifade).",
      "type": "array",
      "items": {
        "$ref": "urn:mekanik:schema:v1:common#/$defs/expression"
      }
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "tick": {
            "properties": {
              "checked": {
                "const": true
              }
            },
            "required": [
              "checked"
            ]
          }
        },
        "required": [
          "tick"
        ]
      },
      "then": {
        "required": [
          "evidence"
        ],
        "properties": {
          "evidence": {
            "minItems": 1
          },
          "status": {
            "const": "met"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "access": {
            "const": "paid"
          }
        },
        "required": [
          "access"
        ]
      },
      "then": {
        "required": [
          "open_equivalent"
        ],
        "properties": {
          "open_equivalent": {
            "properties": {
              "searched": {
                "const": true
              }
            }
          }
        },
        "if": {
          "properties": {
            "open_equivalent": {
              "not": {
                "required": [
                  "found"
                ]
              }
            }
          }
        },
        "then": {
          "required": [
            "procurement"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "library": {
            "const": false
          }
        }
      },
      "then": {
        "required": [
          "work",
          "status",
          "why_here",
          "test_method",
          "acceptance"
        ]
      }
    }
  ]
}
