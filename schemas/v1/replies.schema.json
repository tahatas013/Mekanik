{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mekanik:schema:v1:replies",
  "title": "Yorum yanıtları (replies.yaml)",
  "description": "Ekibin baş mühendis yorumlarına yanıtı; yalnız eklenir (G-29).",
  "x-schema-version": "1.0.0",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "card",
      "comment_at",
      "text",
      "role",
      "at"
    ],
    "properties": {
      "card": {
        "$ref": "urn:mekanik:schema:v1:common#/$defs/card_id"
      },
      "comment_at": {
        "$ref": "urn:mekanik:schema:v1:common#/$defs/timestamp"
      },
      "text": {
        "type": "string",
        "minLength": 1
      },
      "role": {
        "$ref": "urn:mekanik:schema:v1:common#/$defs/role"
      },
      "at": {
        "$ref": "urn:mekanik:schema:v1:common#/$defs/timestamp"
      }
    },
    "additionalProperties": false
  }
}
