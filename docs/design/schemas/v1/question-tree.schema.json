{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mekanik:schema:v1:question-tree",
  "title": "Soru ağacı (question tree)",
  "description": "Alan paketinin tanımladığı soru ağacı. Her soru neden önemli olduğunu, cevap gelmezse ne varsayılacağını ve görselini taşır. Cevap alt soruları açar. Veriden çıkarılabilen soru sorulmaz (derive_from).",
  "x-schema-version": "1.0.0",
  "type": "object",
  "required": [
    "kind",
    "schema_version",
    "id",
    "version",
    "provided_by",
    "applies_to",
    "nodes"
  ],
  "properties": {
    "kind": {
      "const": "question_tree"
    },
    "schema_version": {
      "$ref": "urn:mekanik:schema:v1:common#/$defs/schema_version"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)?$"
    },
    "version": {
      "$ref": "urn:mekanik:schema:v1:common#/$defs/semver"
    },
    "provided_by": {
      "type": "string"
    },
    "applies_to": {
      "type": "array",
      "items": {
        "$ref": "urn:mekanik:schema:v1:common#/$defs/slug"
      },
      "minItems": 1,
      "description": "İş türü kimlikleri."
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      },
      "minItems": 1
    }
  },
  "additionalProperties": false,
  "$defs": {
    "answer_spec": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "choice",
            "number",
            "boolean",
            "text",
            "file"
          ]
        },
        "unit": {
          "type": "string"
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "choices": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "value",
              "label"
            ],
            "properties": {
              "value": {
                "type": [
                  "string",
                  "number",
                  "boolean"
                ]
              },
              "label": {
                "$ref": "urn:mekanik:schema:v1:common#/$defs/text_i18n"
              }
            },
            "additionalProperties": false
          },
          "minItems": 2
        },
        "accept": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "choice"
              }
            }
          },
          "then": {
            "required": [
              "choices"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "number"
              }
            }
          },
          "then": {
            "required": [
              "unit"
            ]
          }
        }
      ]
    },
    "node": {
      "type": "object",
      "required": [
        "id",
        "text",
        "why",
        "answer",
        "default_if_unanswered",
        "visual",
        "urgency"
      ],
      "properties": {
        "id": {
          "$ref": "urn:mekanik:schema:v1:common#/$defs/slug"
        },
        "text": {
          "$ref": "urn:mekanik:schema:v1:common#/$defs/text_i18n"
        },
        "why": {
          "$ref": "urn:mekanik:schema:v1:common#/$defs/text_i18n",
          "description": "Neden önemli: hangi karar ya da hesap bu cevaba dayanıyor."
        },
        "answer": {
          "$ref": "#/$defs/answer_spec"
        },
        "derive_from": {
          "description": "Cevap veriden çıkarılabiliyorsa soru sorulmaz; değer kaynak 'derived' ile kayda girer ve akışa düşer.",
          "type": "object",
          "required": [
            "expression",
            "evidence"
          ],
          "properties": {
            "expression": {
              "$ref": "urn:mekanik:schema:v1:common#/$defs/expression"
            },
            "evidence": {
              "type": "string",
              "description": "Analiz kimliği, ör. molding.projected_area."
            }
          },
          "additionalProperties": false
        },
        "default_if_unanswered": {
          "type": "object",
          "required": [
            "value",
            "source",
            "opens_card"
          ],
          "properties": {
            "value": {
              "type": [
                "string",
                "number",
                "boolean",
                "null"
              ]
            },
            "unit": {
              "type": "string"
            },
            "source": {
              "$ref": "urn:mekanik:schema:v1:common#/$defs/source_tag"
            },
            "rationale": {
              "$ref": "urn:mekanik:schema:v1:common#/$defs/text_i18n"
            },
            "opens_card": {
              "type": "boolean",
              "description": "true: varsayım kartı açılır (kritik varsayım); false: varsayım listesine girer."
            }
          },
          "additionalProperties": false
        },
        "visual": {
          "description": "Soru görseli: gerçek modelden ya da veriden üretilir.",
          "type": "object",
          "required": [
            "generator"
          ],
          "properties": {
            "generator": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)?$"
            },
            "params": {
              "type": "object"
            }
          },
          "additionalProperties": false
        },
        "stop_category": {
          "$ref": "urn:mekanik:schema:v1:common#/$defs/stop_category",
          "description": "Varsa soru mutlaka sorulur; varsayılan sessizce uygulanmaz, iş o konuda durur."
        },
        "urgency": {
          "enum": [
            "now",
            "stage_end"
          ],
          "description": "now: bağımlı iş bekler; stage_end: aşama sonu soru paketine girer."
        },
        "sets": {
          "description": "Cevabın yazılacağı yer.",
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "target",
              "path"
            ],
            "properties": {
              "target": {
                "enum": [
                  "param",
                  "requirement",
                  "work",
                  "intake"
                ]
              },
              "path": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "children": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "when",
              "node"
            ],
            "properties": {
              "when": {
                "$ref": "urn:mekanik:schema:v1:common#/$defs/expression"
              },
              "node": {
                "$ref": "#/$defs/node"
              }
            },
            "additionalProperties": false
          }
        },
        "findings": {
          "description": "Cevaba bağlı çelişki/alternatif bulguları (ör. adet düşükse 'kalıp maliyeti karşılamaz').",
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "when",
              "kind",
              "text"
            ],
            "properties": {
              "when": {
                "$ref": "urn:mekanik:schema:v1:common#/$defs/expression"
              },
              "kind": {
                "enum": [
                  "contradiction",
                  "missing_number",
                  "overlooked",
                  "alternative"
                ]
              },
              "text": {
                "$ref": "urn:mekanik:schema:v1:common#/$defs/text_i18n"
              },
              "basis": {
                "type": "string",
                "description": "Bulgunun dayandığı hesap ya da kaynak."
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "required": [
              "stop_category"
            ]
          },
          "then": {
            "properties": {
              "default_if_unanswered": {
                "properties": {
                  "value": {
                    "const": null
                  },
                  "opens_card": {
                    "const": true
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
