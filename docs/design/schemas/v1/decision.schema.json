{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mekanik:schema:v1:decision",
  "title": "Karar (decision)",
  "description": "Karar kaydı. Kararı hangi rolün verdiği yazılır. Dayandığı hesaplar sonuç özetiyle kayda geçer; özet değişirse karar 'review_needed' olur. Dosya: decisions.yaml (liste).",
  "x-schema-version": "1.0.0",
  "type": "object",
  "required": ["kind", "schema_version", "id", "work", "title", "category", "mode", "decided_by", "options", "rationale", "status", "opened_at"],
  "properties": {
    "kind": {"const": "decision"},
    "schema_version": {"$ref": "urn:mekanik:schema:v1:common#/$defs/schema_version"},
    "id": {"type": "string", "pattern": "^K-[0-9]{2,3}$"},
    "work": {"$ref": "urn:mekanik:schema:v1:common#/$defs/work_code"},
    "title": {"type": "string", "minLength": 1},
    "category": {"$ref": "urn:mekanik:schema:v1:common#/$defs/decision_category"},
    "mode": {"enum": ["hold", "provisional", "review"], "description": "hold: baş mühendis onayı olmadan geçilmez (DUR kategorileri); provisional: geçici karar, kapıya kadar itiraz; review: kayda geçer, iş sürer, sonra incelenir."},
    "decided_by": {"$ref": "urn:mekanik:schema:v1:common#/$defs/role"},
    "options": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "values"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z]$"},
          "title": {"type": "string"},
          "values": {"type": "array", "items": {"$ref": "urn:mekanik:schema:v1:common#/$defs/named_quantity"}, "description": "Seçeneğin değiştirdiği bütün değerler açıkça (E-17: seçenekler birbirinin değerini miras almaz)."},
          "model_definition": {"type": "object", "description": "Seçeneğin model tanımı kayıtta da tutulur (E-15)."},
          "branch": {"type": "string", "pattern": "^[A-Z]{3}-[A-Z]{3}-[0-9]{2}/karar/K-[0-9]{2,3}-[a-z]$"}
        },
        "additionalProperties": false
      }
    },
    "chosen": {"type": "string", "pattern": "^[a-z]$"},
    "rationale": {"type": "string", "minLength": 1},
    "alternatives_considered": {"type": "array", "items": {"type": "string"}},
    "dependents": {
      "description": "Bu karara dayanan parametreler, parçalar ve kararlar (bağımlılık kaydı).",
      "type": "array",
      "items": {"type": "string"}
    },
    "basis": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["calculation", "result_hash", "at"],
        "properties": {
          "calculation": {"$ref": "urn:mekanik:schema:v1:common#/$defs/slug"},
          "result_hash": {"$ref": "urn:mekanik:schema:v1:common#/$defs/short_hash"},
          "at": {"$ref": "urn:mekanik:schema:v1:common#/$defs/timestamp"}
        },
        "additionalProperties": false
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["text", "measured"],
        "properties": {"text": {"type": "string"}, "measured": {"type": "boolean"}, "ref": {"$ref": "urn:mekanik:schema:v1:common#/$defs/ref"}},
        "additionalProperties": false
      }
    },
    "requirement_effects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["requirement", "effect"],
        "properties": {"requirement": {"type": "string", "pattern": "^R-[0-9]{2,3}$"}, "effect": {"type": "string"}},
        "additionalProperties": false
      }
    },
    "status": {"enum": ["proposed", "in_review", "approved", "rejected", "provisional_active", "accepted_at_gate", "objected", "reverted", "review_needed"]},
    "approved_version": {"$ref": "urn:mekanik:schema:v1:common#/$defs/short_hash", "description": "Onaylandığı commit; kapanmış karar o sürümle değerlendirilir (E-21)."},
    "card": {"$ref": "urn:mekanik:schema:v1:common#/$defs/card_id"},
    "objection_until": {"$ref": "urn:mekanik:schema:v1:common#/$defs/gate_id", "description": "Yalnız geçici kararda: itiraz süresinin bittiği kapı."},
    "visual": {"$ref": "urn:mekanik:schema:v1:common#/$defs/ref", "description": "Yalnız geçici kararda: akışta görünen görsel."},
    "provisional": {"$ref": "#/$defs/provisional_state"},
    "opened_at": {"$ref": "urn:mekanik:schema:v1:common#/$defs/timestamp"},
    "closed_at": {"$ref": "urn:mekanik:schema:v1:common#/$defs/timestamp"},
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["at", "event", "role"],
        "properties": {
          "at": {"$ref": "urn:mekanik:schema:v1:common#/$defs/timestamp"},
          "event": {"enum": ["opened", "approved", "rejected", "undone", "objected", "accepted_at_gate", "reverted", "basis_changed", "basis_refreshed"]},
          "role": {"$ref": "urn:mekanik:schema:v1:common#/$defs/role"},
          "note": {"type": "string"},
          "commit": {"$ref": "urn:mekanik:schema:v1:common#/$defs/short_hash"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "provisional_state": {
      "type": "object",
      "required": ["stream_event", "outcome"],
      "properties": {
        "stream_event": {"type": "string", "description": "Akıştaki olay kimliği."},
        "objection": {
          "type": "object",
          "required": ["at", "text"],
          "properties": {
            "at": {"$ref": "urn:mekanik:schema:v1:common#/$defs/timestamp"},
            "text": {"type": "string", "minLength": 1},
            "commit": {"$ref": "urn:mekanik:schema:v1:common#/$defs/short_hash"}
          },
          "additionalProperties": false
        },
        "outcome": {"enum": ["pending", "accepted_no_objection", "objected_reverted", "objected_kept"]},
        "reverted_work": {"type": "array", "items": {"type": "string"}, "description": "Geri alınınca etkilenen işler (bağımlılık kaydından kendiliğinden)."}
      },
      "additionalProperties": false,
      "allOf": [
        {"if": {"properties": {"outcome": {"enum": ["objected_reverted", "objected_kept"]}}}, "then": {"required": ["objection"]}}
      ]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"category": {"$ref": "urn:mekanik:schema:v1:common#/$defs/stop_category"}}, "required": ["category"]},
      "then": {"properties": {"mode": {"const": "hold"}}}
    },
    {
      "if": {"properties": {"mode": {"const": "provisional"}}, "required": ["mode"]},
      "then": {"required": ["objection_until", "visual", "provisional"]},
      "else": {"not": {"anyOf": [{"required": ["objection_until"]}, {"required": ["provisional"]}]}}
    },
    {
      "if": {"properties": {"status": {"enum": ["approved", "accepted_at_gate"]}}, "required": ["status"]},
      "then": {"required": ["chosen", "approved_version"]}
    },
    {
      "if": {"properties": {"observations": {"contains": {"properties": {"measured": {"const": false}}}}}, "required": ["observations"]},
      "then": {"anyOf": [{"required": ["basis"], "properties": {"basis": {"minItems": 1}}}, {"properties": {"observations": {"contains": {"properties": {"measured": {"const": true}}}}}}]}
    }
  ]
}
