      "value": 200,
      "unit": "MB",
      "source": "decision",
      "decided_by": "chief_engineer"
    }
  },
  "policy": {
    "stop_categories": [
      "manufacturing_method",
      "material",
      "main_dimensions",
      "deviation_from_standard",
      "cost_impact",
      "release_production",
      "requirement_change",
      "chief_only_info"
