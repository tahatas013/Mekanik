{
  "kind": "config",
  "schema_version": "1.0",
  "person": {"name": "Örnek Mühendis", "email": "muhendis@example.org", "locale": "tr"},
  "identities": {
    "chief": {"name": "Örnek Mühendis", "email": "muhendis@example.org"},
    "team": {"name": "mekanik-ekip", "email": "ekip@mekanik.local"}
  },
  "paths": {"works_root": "~/work", "cache": "~/.cache/mekanik", "cache_limit": {"value": 5, "unit": "GB", "source": "decision", "decided_by": "chief_engineer"}},
  "organizations": [
    {"code": "IND", "name": "Bağımsız", "repo": "~/work/ind", "remote": null, "cost_threshold": {"value": null, "unit": "TL", "source": "assumption", "note": "belirlenene kadar risk sorusu baş mühendise sorulur"}, "projects": []},
    {"code": "ORN", "name": "Örnek Atölye", "repo": "~/work/orn", "remote": null, "projects": [{"code": "BRK", "name": "Braket", "folder": "braket"}]}
  ],
  "machines": [
    {"id": "printer-1", "type": "print3d.fdm_printer", "name": "Atölye FDM yazıcısı", "status": "provisional", "profile": {"bed": {"x": {"value": 220, "unit": "mm", "source": "manufacturer:kullanim-kilavuzu"}, "y": {"value": 220, "unit": "mm", "source": "manufacturer:kullanim-kilavuzu"}, "z": {"value": 250, "unit": "mm", "source": "manufacturer:kullanim-kilavuzu"}}, "nozzle": {"value": 0.4, "unit": "mm", "source": "manufacturer:kullanim-kilavuzu"}}},
    {"id": "press-1", "type": "molding.press", "name": "Kalıpçının presi", "status": "provisional", "profile": {"clamp_force": {"value": 800, "unit": "kN", "source": "assumption"}}}
  ],
  "instruments": [
    {"id": "caliper-1", "kind": "caliper", "name": "Dijital kumpas", "uncertainty": {"value": 0.05, "unit": "mm", "source": "assumption"}, "valid_for": {"critical_fit": true, "form": true}, "basis": "kendi doğrulamamıza kadar varsayım"},
    {"id": "phone-scan", "kind": "scanner", "name": "Telefon LiDAR taraması", "uncertainty": {"value": 10.0, "unit": "mm", "lower_bound": true, "source": "assumption"}, "valid_for": {"critical_fit": false, "form": true}, "basis": "İkincil kaynaklar ±1 cm sınıfı bildiriyor (Araştırma B, K33); referans parçanın kendi ölçümümüzle taranmasına kadar varsayım"}
  ],
  "agent": {
    "adapter": "claude_code",
    "auth": "subscription",
    "max_turns": 200,
    "permission_mode": "acceptEdits",
    "roles": {
      "project_engineer": {"model": "opus"},
      "design_engineer": {"model": "sonnet"},
      "technician": {"model": "haiku", "tools": ["Read", "Grep", "Glob", "Bash"]},
      "quality_engineer": {"model": "opus", "tools": ["Read", "Grep", "Glob"]}
    }
  },
  "panel": {"host": "127.0.0.1", "port": 8765},
  "policy": {
    "stop_categories": ["manufacturing_method", "material", "main_dimensions", "standard_deviation", "cost_impact", "release_production", "requirement_change", "chief_only_info"],
    "objection_until": "next_gate",
    "batch_non_urgent": true,
    "max_open_provisional": 5,
    "revert_rate_threshold": {"value": 0.2, "unit": "-", "source": "decision", "decided_by": "chief_engineer"},
    "revert_window": 10
  },
  "packages": {"enabled": ["print3d", "molding"]},
  "platform": {"terminal": "none", "service": "none", "remote_access": "none", "notify": "desktop"},
  "daily_summary": {"time": "18:00", "enabled": true}
}
